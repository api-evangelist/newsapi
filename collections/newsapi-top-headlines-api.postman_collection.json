  "item": [
    {
      "id": "4bbf8fe2-b3ca-487d-8dd2-9c557c7b5a76",
      "name": "Top Headlines",
      "description": {
        "content": "Get live top and breaking headlines",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "b27e7dfd-0fc6-4e62-ad30-5e49bebd21fe",
          "name": "Get top headlines",
          "request": {
            "name": "Get top headlines",
            "description": {
              "content": "Provides live top and breaking headlines for a country, specific category in a country, single source, multiple sources, or a query. You can use this endpoint to get breaking news programmatically and use it to fuel your news-driven apps and news feeds.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "top-headlines"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "country",
                  "value": "<string>",
                  "description": "The 2-letter ISO 3166-1 code of the country you want to get headlines for. Note: you can't mix this param with the sources param.\n"
                },
                {
                  "disabled": false,
                  "key": "category",
                  "value": "<string>",
                  "description": "The category you want to get headlines for. Note: you can't mix this param with the sources param.\n"
                },
                {
                  "disabled": false,
                  "key": "sources",
                  "value": "<string>",
                  "description": "A comma-separated string of identifiers for the news sources or blogs you want headlines from. Use the /top-headlines/sources endpoint to locate these. Note: you can't mix this param with the country or category params.\n"
                },
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "Keywords or a phrase to search for."
                },
                {
                  "disabled": false,
                  "key": "pageSize",
                  "value": "20",
                  "description": "The number of results to return per page. Default is 20, maximum is 100."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Use this to page through the results. Default is 1."
                },
                {
                  "disabled": false,
                  "key": "apiKey",
                  "value": "<string>",
                  "description": "Your API key. Alternatively provide via the X-Api-Key header."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
