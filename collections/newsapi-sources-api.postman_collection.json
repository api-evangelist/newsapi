  "info": {
    "_postman_id": "fa546f27-6539-485b-bf6b-c70ee311b4fa",
    "name": "News Everything Sources API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "NewsAPI is a simple, easy-to-use REST API that returns JSON metadata for news articles and breaking headlines published by over 80,000 worldwide sources and blogs. The API supports full-text keyword search across hundreds of millions of articles, filtering by source domain, language, date range, and sorting by relevance or publication date. A dedicated top-headlines endpoint delivers live breaking news by country and category. Developers authenticate via an API key passed as a query parameter or HTTP header.\n\n\nContact Support:\n Name: NewsAPI Support",
      "type": "text/plain"
    }
  }
